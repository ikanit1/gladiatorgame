# --- Godot ---
# Кеш импорта: пересобирается сам, весит больше сотни мегабайт и постоянно
# меняется. А вот файлы *.import и *.uid рядом с ассетами НУЖНЫ в репозитории:
# в них лежат идентификаторы, по которым сцены ссылаются на ресурсы.
.godot/
*.translation

# --- Обучение ---
# Промежуточные чекпоинты и логи TensorBoard: десятки мегабайт, которые
# заново получаются любым прогоном. Итоговая модель и статистика
# нормализации остаются в истории намеренно - без них нельзя ни продолжить
# обучение, ни выгрузить политику для игры.
training/runs/*/checkpoints/
training/runs/*/ppo_*/
training/runs/*/live_stats.json
training/runs/*/live_play.json

# --- Временное ---
*.tmp
_t/
_shot/
_smoke/
_rltest/

# --- Система ---
Thumbs.db
desktop.ini
.DS_Store
